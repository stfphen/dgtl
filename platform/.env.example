# Local development placeholders only. Do not reuse these values in production.
POSTGRES_DB=content_funnel_local
POSTGRES_USER=content_funnel_local
POSTGRES_PASSWORD=local-dev-postgres-password-change-me
DATABASE_URL=postgres://content_funnel_local:local-dev-postgres-password-change-me@localhost:5432/content_funnel_local

OWNER_EMAIL=owner@example.com
OWNER_NAME=Local Owner
TEAM_NAME=Local Team
TEAM_SLUG=local-team
# OWNER_PASSWORD is intentionally omitted. Pass it as a one-time environment
# variable when running npm run create-owner.

PUBLIC_APP_URL=http://localhost:8088

RESEND_API_KEY=
# Verified Resend sender used as the default From for outreach when a queue item
# has no explicit sender (must be on a domain you've verified in Resend).
RESEND_FROM=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=

# Outreach batch sending.
# OUTREACH_DRY_RUN=true forces the mock email provider for ALL sends (records
# "sent" + events + a dryrun_* id, no real email) — use for demos/staging.
OUTREACH_DRY_RUN=
# Bearer token the scheduled-send drain endpoint requires. Generate a strong
# random value; the host cron passes it to POST /api/cron/outreach/drain.
OUTREACH_CRON_TOKEN=
# Secret used to sign one-click unsubscribe links. Falls back to SESSION_SECRET
# if unset; set a dedicated value in production.
UNSUBSCRIBE_SECRET=

# DGTL Core canonical outbox. Test is the default and makes no network calls.
# A Resend production worker requires ALL independent gates below: transport,
# enabled flag, release ID, authorization phrase suffixed by that release ID,
# and a matching reviewed-rate-policy release ID. Never enable these for staging.
CORE_EMAIL_TRANSPORT=test
CORE_WORKER_TEAM_ID=
CORE_WORKER_ID=
CORE_PRODUCTION_SEND_ENABLED=false
CORE_PRODUCTION_SEND_RELEASE_ID=
CORE_PRODUCTION_SEND_AUTHORIZATION=
CORE_RATE_POLICY_APPROVED=
# Safe staging defaults. Production values require explicit deliverability review.
CORE_RATE_ACCOUNT_DAILY=25
CORE_RATE_DOMAIN_DAILY=1
CORE_RATE_TEAM_DAILY=50
CORE_RATE_BATCH=10
CORE_WORKER_CONCURRENCY=2
CORE_RETRY_BACKOFF_BASE_MS=60000
CORE_RETRY_BACKOFF_MAX_MS=3600000
# Signed Resend webhook boundary. CORE_PROVIDER_TEAM_ID is server-owned routing
# configuration, never accepted from the webhook payload.
RESEND_WEBHOOK_SECRET=
CORE_PROVIDER_TEAM_ID=

# --- DGTL Core artifact generation workers (Stage 3) ---
# Scoped server-to-worker boundary. The token is never exposed to browser code;
# the configured team is authoritative and request input cannot override it.
CORE_GENERATION_WORKER_TOKEN=
CORE_GENERATION_WORKER_TEAM_ID=
CORE_GENERATION_WORKER_ID=generation-worker
# Local/staging HTML preview volume shared by the worker and Core server.
# Defaults to the operating system temp directory; configure persistent staging explicitly.
CORE_ARTIFACT_PREVIEW_ROOT=
# Reserved future release gate. This variable does not enable deployment by
# itself: production adapters are disabled in the registry and browser routes
# hardcode production authorization off.
CORE_ARTIFACT_PRODUCTION_DEPLOY_AUTHORIZED=false
DGTL_SOURCE_COMMIT=

# Optional: YouTube Data API v3 key — used only to resolve @handle / user/
# channel links in the hero-video picker. Without it, resolution falls back to
# fetching the public channel page (works, but the API path is the stable one).
YOUTUBE_API_KEY=

# Enterprise Prospecting (account-based) sourcing.
# SEC EDGAR needs NO key (free), but requires a descriptive User-Agent with contact
# info or SEC returns 403. Override the default here.
SEC_EDGAR_USER_AGENT=
# OpenCorporates works anonymously at a limited rate; a token raises limits + unlocks fields.
OPENCORPORATES_API_TOKEN=
# Real per-account research (committee/signals) uses the AI backend below
# (CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY). Without it, research falls back to an
# offline dossier. Apollo + Hunter (above) supply real contacts when an account has a domain.

# Optional: enables the LLM sales brief in the enrichment workflow.
# When unset, the workflow falls back to the deterministic brief.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Claude (Anthropic) auth for the AI features ---------------------------
# These power the AI Tenant Builder, AI Deep Research, and "Fill missing info".
# Pick ONE path:
#
# (A) Subscription (Claude Max/Pro) via the Claude Agent SDK — no per-token API
#     billing. Generate a long-lived token once with `claude setup-token`
#     (install the CLI: npm i -g @anthropic-ai/claude-code) and paste it here.
#     Preferred when set. Requires the Node runtime (spawns the Claude Code CLI).
CLAUDE_CODE_OAUTH_TOKEN=
#
# (B) Pay-as-you-go API key from console.anthropic.com. Used as an automatic
#     fallback when CLAUDE_CODE_OAUTH_TOKEN is unset (or a subscription call
#     fails). When neither is set, the features return a clear "not configured"
#     error.
ANTHROPIC_API_KEY=

# Optional: override the Deep Research model (defaults to claude-opus-4-8).
LEAD_RESEARCH_MODEL=
# Optional: cap web_search/web_fetch uses per research run for cost control (default 8).
LEAD_RESEARCH_MAX_WEB_SEARCHES=

# Stripe Checkout. When unset, checkout packages fall back to Payment Links or
# lead capture. Use sk_test_/whsec_ locally (whsec_ from `stripe listen`) and
# sk_live_/whsec_ (from the dashboard webhook endpoint) in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Telephony (Twilio) ----------------------------------------------------
# When TWILIO_* are unset, telephony reports "not configured" and the app is
# unaffected. Secrets here only — never store them in tenant config. See
# TELEPHONY.md for the full setup + local-webhook walkthrough.

# Provider selection (only "twilio" is implemented).
TELEPHONY_PROVIDER=twilio

# Public origin Twilio calls for webhooks. MUST match the URL Twilio is
# configured with byte-for-byte (scheme, host, path, no trailing slash) or
# signature verification fails. In dev this is your ngrok https URL; in prod
# your domain. Falls back to NEXT_PUBLIC_APP_URL when unset.
NEXT_PUBLIC_APP_URL=http://localhost:8088
TELEPHONY_WEBHOOK_BASE_URL=

# Twilio credentials (secrets — never commit). Signature verification uses
# TWILIO_AUTH_TOKEN. API key/secret are reserved for future client-token flows.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WEBHOOK_SECRET=

# Deepgram — primary call-transcription provider (Whisper/OpenAI is the fallback).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Defaults (this pass normalizes +1 US/Canada numbers only).
DEFAULT_COUNTRY_CODE=CA
DEFAULT_TIMEZONE=America/Toronto

# --- Stage 4: Worklog delivery bridge (server-only; never sent to a browser) ---
# Worklog origin. No default — unset means the integration is off. Production
# (https://office.dgtl.at) must only be configured deliberately, after the
# dedicated integration account below exists there.
CORE_WORKLOG_BASE_URL=
# Dedicated Worklog integration account. Needs the Worklog "admin" role to
# create delivery projects; "member" suffices for task handoff only. Worklog
# revokes sessions when this password changes — update it here in step.
CORE_WORKLOG_EMAIL=
CORE_WORKLOG_PASSWORD=
# The single Core team allowed to use the connector (same server-owned team
# binding as the Stage 3 worker). Unset fails closed for every team.
CORE_WORKLOG_TEAM_ID=

# --- Stage 6: DGTL.chat command & action layer (server-only) ---
# Chat model provider. Unset = DGTL.chat shows an unconfigured state and the
# rest of the platform is unaffected. "deterministic" runs the rule-based
# adapter with no external AI dependency (used by CI/acceptance and safe for
# demos). "anthropic" uses the shared Claude transport via ANTHROPIC_API_KEY
# above (API-key path only — the subscription path is deliberately not used
# for the chat tool loop). "disabled" turns chat off explicitly.
CORE_CHAT_PROVIDER=
# Model for the anthropic chat adapter (defaults to claude-sonnet-5; chat is
# deliberately not pinned to the Opus research default).
CORE_CHAT_MODEL=

# --- Release identity (non-secret) ---
# Set at deploy time to the deployed Git SHA; surfaced by the authenticated
# /api/core/health endpoint for support and rollback verification.
CORE_RELEASE_SHA=
