{
  "name": "dgtl-worklog",
  "version": "0.1.0",
  "private": true,
  "description": "DGTL Worklog — internal work, hours and to-do tracker. Zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/server.mjs",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/server.mjs",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.mjs",
    "demo": "node --no-warnings=ExperimentalWarning scripts/demo.mjs",
    "user": "node --no-warnings=ExperimentalWarning scripts/user.mjs",
    "test": "node --no-warnings=ExperimentalWarning tests/smoke.mjs"
  }
}
