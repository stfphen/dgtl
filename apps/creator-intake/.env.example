# DGTL Creator & Brand Intake — environment template.
# Copy to .env (gitignored). In production the real .env lives ONE LEVEL ABOVE
# the webroot (~/domains/join.dgtlinfluence.com/.env) — env.php looks there first.

APP_ENV=dev                       # dev | production
APP_URL=http://localhost:8080     # no trailing slash; prod: https://join.dgtlinfluence.com

# Database. dev = sqlite (schema auto-applied), production = mysql (import schema.sql first).
DB_DRIVER=sqlite
DB_SQLITE_PATH=./dev.sqlite       # relative to apps/creator-intake/
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASS=

# Hostinger SMTP (production). In dev, emails are written to files instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=join@dgtlinfluence.com
SMTP_PASS=
MAIL_FROM=join@dgtlinfluence.com
MAIL_FROM_NAME="DGTL Influence"
ADMIN_NOTIFY_EMAIL=               # gets a note on each new submission (optional)

# Cloudflare R2 (S3-compatible). Token scoped: Object Read & Write, this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dgtl-creator-intake

# Admin login. Hash: php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Version stamped onto every signature; bump when terms.html changes materially.
TERMS_VERSION=2026-08-v1

# 32+ random bytes hex, mixed into token hashes. php -r "echo bin2hex(random_bytes(32));"
TOKEN_PEPPER=
