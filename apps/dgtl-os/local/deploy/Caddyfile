# DGTL OS — Caddy site (auto HTTPS via Let's Encrypt + password login)
# Placeholders are filled in by install.sh.

__DOMAIN__ {
	encode zstd gzip

	# password gate for the whole site (shared login)
	basicauth {
		__USER__ __HASH__
	}

	# forward to the local Node app (localhost only)
	reverse_proxy 127.0.0.1:8787
}
