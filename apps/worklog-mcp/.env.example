# DGTL Worklog MCP — copy to .env and fill in.
# .env is gitignored repo-wide (see /.gitignore line 12). Never commit real values.

WORKLOG_BASE_URL=https://office.dgtl.at

# The dedicated bot account. Not a human's login — all task/project writes are
# attributed to this user in Worklog, so activity stays auditable.
WORKLOG_EMAIL=claude@dgtl.at
WORKLOG_PASSWORD=replace-me
