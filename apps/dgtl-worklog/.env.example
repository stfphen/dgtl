# DGTL Worklog — configuration
# Copy to `.env` (never commit the real file; the repo .gitignore already excludes it).

# --- server ---
# Bind 0.0.0.0 for local/LAN use. In production put it behind a reverse proxy
# (see deploy/Caddyfile) and bind loopback only.
HOST=0.0.0.0
PORT=8123

# --- data ---
# SQLite file. Relative paths resolve against the app directory.
DB_PATH=data/worklog.sqlite

# --- dates ---
# Every time entry is filed under a calendar date in THIS timezone, so a team
# in one office all agrees on what "today" means regardless of server locale.
APP_TIMEZONE=America/Toronto

# --- sessions ---
# Session cookies are signed by their own random token, not by a shared secret,
# so there is no key to rotate here. Lifetime in days:
SESSION_DAYS=30

# Set to 1 when served over HTTPS so the session cookie carries the Secure flag.
# Leave 0 for plain-http local use, otherwise the browser drops the cookie.
SECURE_COOKIES=0

# Trust X-Forwarded-For for client IPs (rate limiting / audit). Only enable
# when a reverse proxy you control sets it — otherwise clients can spoof it.
TRUST_XFF=0

# --- seeding ---
# Used by `npm run seed` to create the first admin. Change the password after
# first login, or pass your own: `npm run seed -- --email you@dgtl --password '…'`
SEED_ADMIN_EMAIL=admin@dgtlgroup.io
SEED_ADMIN_NAME=DGTL Admin
SEED_ADMIN_PASSWORD=

# --- first-boot admin (for hosts where you cannot get a shell) ---
# If the users table is COMPLETELY empty on boot, these create the first admin.
# Once any user exists they are ignored, so they can never reset a live account.
# Set them for the first deploy, sign in, change the password, then delete them.
# BOOTSTRAP_ADMIN_EMAIL=you@dgtlgroup.io
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_PASSWORD=
