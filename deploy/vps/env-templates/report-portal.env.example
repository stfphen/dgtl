# deploy/report-portal — deploy.dgtl.report
# Copy to /opt/dgtl/deploy/report-portal/.env on the VPS. NEVER commit the live file.
# Generate a NEW token (do not reuse the dgtlmag deploy token):
#   openssl rand -hex 32
DEPLOY_TOKEN=CHANGE_ME
# Optional overrides (compose already sets sane values):
# REPORT_BASE=https://dgtl.report
# AUDIT_BASE=https://audit.dgtl.report
# MAX_ZIP_BYTES=150000000
