# deploy/publish-portal — deploy.dgtl.ltd
# Copy to /opt/dgtl/deploy/publish-portal/.env on the VPS. NEVER commit the live file.
#
# ONE token now covers every destination (corporate pitches, legacy pitches, status
# reports, client audits, galleries, photo sets, video pages). It replaces the two
# separate tokens the retired deploy.dgtlmag.com and deploy.dgtl.report portals used.
# Mint a FRESH value at cutover and retire both old ones:
#   openssl rand -hex 32
DEPLOY_TOKEN=CHANGE_ME

# Optional:
# MAX_ZIP_BYTES=150000000
# TARGETS_FILE=/app/targets.json          # mount your own registry to add destinations
# Per-destination overrides, mostly for local dev — KEY uppercased, '-' -> '_':
# TARGET_PITCH_LTD_DIR=/data/pitch-ltd
# TARGET_PITCH_LTD_BASE=https://pitch.dgtl.ltd
