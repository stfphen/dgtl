# Copy to apps/dgtl-os/local/deploy/docker/.env
# pgvector side (keep user dgtl / db dgtlkb so db-dumps/dgtlkb.sql restores clean):
POSTGRES_DB=dgtlkb
POSTGRES_USER=dgtl
POSTGRES_PASSWORD=
# dgtl-os side:
PROVIDER=ollama
MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=
PGVECTOR_URL=
RAG_TOPK=
RATE_PER_MIN=
HOST=0.0.0.0
PORT=8787
# Also replace __BASICAUTH__ in docker-compose.yml with a NEW htpasswd hash (see DEPLOY-DOCKER.md).
