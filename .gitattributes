# No Git LFS. Prototypes and rendered video were deliberately left out of this repo, so nothing
# here comes close to needing it — the largest tracked asset is a 1.7 MB PNG
# (platform/public/assets/content-day-hero.png), well under GitHub's 100 MB limit. Keep it that
# way: if you ever need video, host it and reference the URL rather than committing the file.

# Normalize text
*.html text
*.css  text
*.js   text
*.jsx  text
*.mjs  text
*.ts   text
*.md   text
*.json text
*.sql  text
*.sh   text eol=lf
*.py   text eol=lf

# Treat as binary
*.png  binary
*.jpg  binary
*.ico  binary
*.wav  binary

# Keep generated lockfile diffs out of review noise
package-lock.json linguist-generated=true -diff
