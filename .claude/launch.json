{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platform",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "platform", "run", "dev"],
      "port": 8088
    },
    {
      "name": "creator-intake",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "localhost:8080", "-t", "apps/creator-intake/site"],
      "port": 8080
    },
    {
      "name": "journal",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8091", "--directory", "journal"],
      "port": 8091
    },
    {
      "name": "dgtl-pass-previews",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8093", "--directory", "docs/specs/dgtl-pass/previews"],
      "port": 8093
    },
    {
      "name": "passes-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "platform", "run", "demo:passes"],
      "port": 8090
    }
  ]
}
