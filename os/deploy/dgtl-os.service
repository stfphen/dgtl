[Unit]
Description=DGTL OS terminal (Node + local Ollama models)
After=network-online.target ollama.service
Wants=network-online.target ollama.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=dgtlos
WorkingDirectory=/opt/dgtl-os
# localhost-only: the public edge is Caddy, not Node
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=PROVIDER=ollama
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=MODEL=__MODEL__
Environment=RATE_PER_MIN=__RATE__
ExecStart=/usr/bin/node /opt/dgtl-os/server.mjs
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
