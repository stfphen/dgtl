# Dependencies & build output
node_modules/
.next/
dist/
build/
coverage/
*.tgz
__pycache__/
*.pyc

# Secrets — .env.example is the only env file that ships
.env
.env.*
!.env.example

# Platform runtime state (JSON fallback store + media-library uploads)
platform/data/
platform/public/uploads/
backups/
*.dump

# Generated standalone pages (built on demand from source via engine/)
**/*.standalone.html

# Obsidian: vault config is tracked, vendored plugin bundles are not
brain/.obsidian/plugins/
brain/.obsidian/workspace.json

# OS / editor cruft
.DS_Store
._*
Thumbs.db
*.log

# Redundant build archives (source dirs are tracked instead)
*.zip

# DGTL OS — the local server reads its key from this file; never commit one
**/api-key.txt
apps/dgtl-os/local/knowledge/knowledge.json.local

# creator-intake local dev artifacts
apps/creator-intake/*.sqlite
apps/creator-intake/dev-mail/

# Local Worklog v2 handoff/review bundle; canonical source lives in apps/worklog/
apps/dgtl-worklog-demo/

# Apple Wallet (DGTL Pass) signing material. The Pass Type ID private key and
# certificates live in the secrets store; local working copies stay in
# platform/data/passkit/ (already ignored). Belt and braces for stray files:
*.p12
*.cer
passkit*.key
passkit*.pem
